FoamFile
{
    format      ascii;
    class       volVectorField;
    location    "1";
    object      U;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 1 -1 0 0 0 0];

internalField   uniform (0 0 0);

boundaryField
{
    inlet
    {
        type            fixedValue;
        value           uniform (0 0 0);
    }
    outlet
    {
        type            zeroGradient;
    }
    farfield
    {
        type            slip;
    }
    Part_1_5
    {
        type            noSlip;
    }
    Part_1_4
    {
        type            noSlip;
    }
    Part_1_1
    {
        type            noSlip;
    }
    Part_1_2
    {
        type            noSlip;
    }
    Part_1_3
    {
        type            noSlip;
    }
    Part_1_6
    {
        type            noSlip;
    }
    Part_1_1_2
    {
        type            noSlip;
    }
}


