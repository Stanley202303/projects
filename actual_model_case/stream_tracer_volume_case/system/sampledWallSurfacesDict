FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      sampledWallSurfacesDict;
}

functions
{
    sampledWallSurfaces
    {
        type            surfaces;
        libs            ("libsampling.so");
        enabled         true;
        writeControl    writeTime;
        surfaceFormat   vtk;
        interpolationScheme cellPoint;
        fields          (p pPa Cp U k omega nut);
        surfaces
        (
        object_1_sampled
        {
            type        patch;
            patches     (object_1);
            interpolate true;
        }
        object_2_sampled
        {
            type        patch;
            patches     (object_2);
            interpolate true;
        }
        );
    }
}
