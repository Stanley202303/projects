FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      controlDict;
}

application     simpleFoam;

startFrom       startTime;
startTime       0;

stopAt          endTime;
endTime         10;

deltaT          1;

writeControl    timeStep;
writeInterval   10;

// Keep only the latest written solution time. This prevents a 5M+ cell case
// from filling the Docker/host disk with 0,1,2,3,... field folders.
purgeWrite      1;
writeFormat     ascii;
writePrecision  8;
writeCompression off;
timeFormat      general;
timePrecision   6;

runTimeModifiable true;

functions
{
    forces_object_1
    {
        type            forces;
        libs            ("libforces.so");
        patches         (object_1);

        p               p;
        U               U;
        rho             rhoInf;
        rhoInf          1.225;
        pRef            0;

        CofR            (0.00031451 0.00257239 0.000289238);

        enabled         true;
        writeToFile     true;
        writeFields     no;
        executeControl  timeStep;
        executeInterval 10;
        writeControl    timeStep;
        writeInterval   10;
        log             true;
    }
    forceCoeffs_object_1
    {
        type            forceCoeffs;
        libs            ("libforces.so");
        patches         (object_1);

        p               p;
        U               U;
        rho             rhoInf;
        rhoInf          1.225;
        pRef            0;

        CofR            (0.00031451 0.00257239 0.000289238);

        dragDir         (1 0 0);
        liftDir         (0 0 1);
        pitchAxis       (0 1 0);

        magUInf         0;
        lRef            0.109064;
        Aref            0.00403549;

        enabled         true;
        writeToFile     true;
        writeFields     no;
        executeControl  timeStep;
