FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      sampledWallSurfacesDict;
}

functions
{
    sampledWallSurfaces
    {
        type            surfaces;
        libs            ("libsampling.so");
        enabled         true;
        writeControl    writeTime;
        surfaceFormat   vtk;
        interpolationScheme cellPoint;
        fields          (p pPa Cp U k omega nut);
        surfaces
        (
        Part_1_3_sampled
        {
            type        patch;
            patches     (Part_1_3);
            interpolate true;
        }
        Part_1_4_sampled
        {
            type        patch;
            patches     (Part_1_4);
            interpolate true;
        }
        Part_1_1_sampled
        {
            type        patch;
            patches     (Part_1_1);
            interpolate true;
        }
        Part_1_6_sampled
        {
            type        patch;
            patches     (Part_1_6);
            interpolate true;
        }
        Part_1_5_sampled
        {
            type        patch;
            patches     (Part_1_5);
            interpolate true;
        }
        Part_1_2_sampled
        {
            type        patch;
            patches     (Part_1_2);
            interpolate true;
        }
        );
    }
}
